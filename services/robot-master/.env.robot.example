# robot-master settings. Copy to .env.robot (git-ignored) on the robot PC only.
SEMMAL_ROBOT_ID=
# From the dashboard: Your robots -> Link robot. A revocable token, not a wallet key.
SEMMAL_LINK_TOKEN=
# The platform machine (the Mac) on your network
SEMMAL_PLATFORM_URL=http://<platform-ip>:3001
SEMMAL_GATEWAY_URL=ws://<platform-ip>:3001/api/gateway
# The ROS gateway node (semmal_gateway) on this robot PC
SEMMAL_LOCAL_API=http://127.0.0.1:8765
# Same data dir the ROS stack uses (scripts/robot/run_sim.sh sets SEMMAL_DATA_DIR=<repo>/data)
SEMMAL_DATA_DIR=
SEMMAL_INCIDENT_SPOOL=
# Device key made by `pnpm keygen` (default ~/.semmal/robot-key). The key never leaves this machine.
SEMMAL_ROBOT_KEY_FILE=
# Arkiv access key (https://hub.arkiv.network/access-keys); not a secret, restrict it to this host
ARKIV_ACCESS_KEY=
# 0G Storage on Galileo (docs/FACT_CHECK.md)
ZEROG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# Caps for what the device key may spend automatically
ROBOT_MAX_ARKIV_FEE_WEI=10000000000000000
ROBOT_MAX_ARKIV_WRITES_PER_DAY=200
ROBOT_MAX_UPLOADS_PER_DAY=100
