# Robot host link settings. Copy to .env.robot (git-ignored) on the robot host only.
SEMMAL_GATEWAY_URL=ws://127.0.0.1:3001/api/gateway
SEMMAL_ROBOT_ID=
# From your dashboard: Your robots -> Link. Shown once. A revocable token, not a wallet key.
SEMMAL_LINK_TOKEN=
# JSON the ROS 2 gateway node writes: {"safetyState":"NORMAL","batteryPct":81,"zone":"aisle-c","availability":"available","executor":true}
SEMMAL_STATE_FILE=/tmp/semmal-robot-state.json
