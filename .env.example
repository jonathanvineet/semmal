# Copy to .env (git-ignored). Placeholders only. Never put real keys in this file.
NODE_ENV=development
APP_MODE=simulation
API_PORT=3001
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable by robot PCs on your network
API_HOST=0.0.0.0
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# other public origins the web app is served from, comma-separated (e.g. https://semmal.vercel.app)
WEB_EXTRA_ORIGINS=
# Admin = your wallet. Sign in at /admin; the owner is claimed once with a setup code printed by the API.
# Roles live in data/admin.json (git-ignored), not here.
# Show seed listings labelled SIMULATED while nothing is registered on Arkiv.
SHOW_SIMULATED_FIXTURES=true
DATABASE_URL=postgresql://user:password@localhost:5432/semmal
REDIS_URL=redis://localhost:6379

# 0G Compute Router (verified 2026-11-05, docs.0g.ai .../compute-network/router/overview)
#   mainnet: https://router-api.0g.ai/v1   testnet: https://router-api-testnet.integratenetwork.work/v1
#   key: pc.0g.ai -> Dashboard -> API Keys (sk-...). Server-side only.
ZEROG_ROUTER_BASE_URL=
ZEROG_ROUTER_API_KEY=
ZEROG_DEFAULT_MODEL=
ZEROG_VISION_MODEL=
ZEROG_REQUIRED_TRUST_MODE=private
ZEROG_REQUEST_TIMEOUT_MS=30000
# Management key (mk-, preset "Key Manager", scope keys:create): pc.0g.ai -> Settings -> Management Keys.
# Server-side only. With it, each agent gets its own sk- key capped at ZEROG_AGENT_CREDIT_LIMIT per day
# (in the account's settlement currency, normally 0G). Without it all agents share ZEROG_ROUTER_API_KEY.
ZEROG_ROUTER_MANAGEMENT_KEY=
ZEROG_AGENT_CREDIT_LIMIT=0.5
# Payments: native 0G on 0G Galileo testnet (chain 16602). Customers pay robots from their own wallet;
# robots pay agents with their device key. The platform only checks transfers; it holds no key or money.
ZEROG_PAY_RPC_URL=https://evmrpc-testnet.0g.ai

# Arkiv (Rabdi testnet, chain 7794095, SDK @arkiv-network/sdk 1.0.1; RPC is built by the SDK)
#   access key: https://hub.arkiv.network/access-keys   faucet: https://hub.arkiv.network/faucet
ARKIV_ACCESS_KEY=
# Trusted publishers are managed in the /admin dashboard. Writes are signed by your wallet at /publish.
ARKIV_PROFILE_TTL_DAYS=90

ZEROG_STORAGE_RPC_URL=
ZEROG_STORAGE_INDEXER_URL=
# Storage uploads will be wallet-signed too (no signer key), design in Phase 5.


PRIVY_APP_ID=
PRIVY_APP_SECRET=
IAI_INTEGRATION_ENABLED=false

ROBOT_ID=robot-demo-001
ROS_DOMAIN_ID=42
ROS_NAMESPACE=/semmal
SIM_WORLD=warehouse
SIM_FAULT_INJECTION_ENABLED=true
