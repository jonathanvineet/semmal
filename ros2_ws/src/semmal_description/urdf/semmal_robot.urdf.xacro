<?xml version="1.0"?>
<!--
  SEMMAL indoor differential-drive inspection robot (simulation model).
  Frames: base_footprint (ground) -> base_link (axle height) -> {left,right}_wheel_link,
          base_scan, camera_link -> camera_optical_frame, imu_link.
  Gazebo Harmonic (gz-sim 8) systems only. No Gazebo Classic plugins.
  Units: metres, kilograms, radians.
-->
<robot name="semmal_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="model_name" default="semmal"/>
  <xacro:property name="model_name" value="$(arg model_name)"/>
  <!-- Body style: rover (warehouse), cleaner (house), field (forest). Visual only: the collision box,
       wheels, sensors, mass and limits are identical for all three, so safety and plant models hold. -->
  <xacro:arg name="variant" default="rover"/>
  <xacro:property name="variant" value="$(arg variant)"/>

  <!-- Geometry -->
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.36"/>
  <xacro:property name="base_x" value="0.40"/>
  <xacro:property name="base_y" value="0.30"/>
  <xacro:property name="base_z" value="0.14"/>
  <xacro:property name="base_z_offset" value="0.04"/> <!-- base box centre above axle -->
  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_x" value="0.15"/>
  <xacro:property name="com_x" value="-0.04"/> <!-- CoM behind the axle: wheels carry most of the load -->

  <!-- Mass -->
  <xacro:property name="base_mass" value="8.0"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="caster_mass" value="0.1"/>

  <!-- Limits (also enforced by safety_supervisor; these are the plant's hard caps) -->
  <xacro:property name="max_linear_velocity" value="0.8"/>
  <xacro:property name="max_angular_velocity" value="2.0"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0" iyy="${2*m*r*r/5}" iyz="0" izz="${2*m*r*r/5}"/>
  </xacro:macro>

  <material name="graphite"><color rgba="0.16 0.17 0.19 1"/></material>
  <material name="safety_orange"><color rgba="0.95 0.45 0.08 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="appliance_white"><color rgba="0.92 0.93 0.94 1"/></material>
  <material name="sky_blue"><color rgba="0.25 0.60 0.90 1"/></material>
  <material name="olive"><color rgba="0.33 0.38 0.22 1"/></material>
  <material name="beacon_amber"><color rgba="1.0 0.65 0.0 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <xacro:if value="${variant == 'rover'}">
      <visual>
        <origin xyz="0 0 ${base_z_offset}"/>
        <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
        <material name="graphite"/>
      </visual>
      <visual>
        <origin xyz="0 0 ${base_z_offset + base_z/2 + 0.005}"/>
        <geometry><box size="${base_x - 0.04} ${base_y - 0.04} 0.01"/></geometry>
        <material name="safety_orange"/>
      </visual>
    </xacro:if>
    <xacro:if value="${variant == 'cleaner'}">
      <!-- round home-cleaning robot: low white disc, blue bumper ring, brush plate -->
      <visual>
        <origin xyz="0 0 ${base_z_offset - 0.01}"/>
        <geometry><cylinder radius="${base_x/2}" length="${base_z - 0.04}"/></geometry>
        <material name="appliance_white"/>
      </visual>
      <visual>
        <origin xyz="0 0 ${base_z_offset - 0.03}"/>
        <geometry><cylinder radius="${base_x/2 + 0.008}" length="0.025"/></geometry>
        <material name="sky_blue"/>
      </visual>
      <visual>
        <origin xyz="0 0 ${base_z_offset + (base_z - 0.04)/2 - 0.004}"/>
        <geometry><cylinder radius="${base_x/2 - 0.06}" length="0.01"/></geometry>
        <material name="graphite"/>
      </visual>
    </xacro:if>
    <xacro:if value="${variant == 'field'}">
      <!-- rugged field rover: olive hull, roll bar, amber beacon -->
      <visual>
        <origin xyz="0 0 ${base_z_offset}"/>
        <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
        <material name="olive"/>
      </visual>
      <visual>
        <origin xyz="-0.12 0 ${base_z_offset + base_z/2 + 0.07}"/>
        <geometry><box size="0.03 ${base_y} 0.14"/></geometry>
        <material name="black"/>
      </visual>
      <visual>
        <origin xyz="-0.12 0 ${base_z_offset + base_z/2 + 0.16}"/>
        <geometry><cylinder radius="0.03" length="0.04"/></geometry>
        <material name="beacon_amber"/>
      </visual>
    </xacro:if>
    <collision>
      <origin xyz="0 0 ${base_z_offset}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${com_x} 0 ${base_z_offset}"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- Drive wheels -->
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <!-- Sphere collision: one contact point at the true track width. A cylinder's edge
           contacts made the effective track ~0.32 m and odometry under-reported yaw by ~10%. -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${-pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation/2}"/>
  <xacro:wheel side="right" y="${-wheel_separation/2}"/>

  <!-- One passive rear caster (frictionless sphere). Two wheels + one caster keeps the contact
       statically determinate; a four-point contact let the wheels unload and slip when turning. -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual><geometry><sphere radius="${caster_radius}"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
      <inertial><mass value="${caster_mass}"/><xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/></inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
    </joint>
    <gazebo reference="${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="rear" x="${-caster_x}"/>

  <!-- 2D lidar -->
  <link name="base_scan">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <inertial><mass value="0.1"/><xacro:cylinder_inertia m="0.1" r="0.035" h="0.04"/></inertial>
  </link>
  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.05 0 ${base_z_offset + base_z/2 + 0.03}"/>
  </joint>
  <gazebo reference="base_scan">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>base_scan</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
        </scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- RGB camera (optical frame follows REP-103: z forward, x right, y down) -->
  <!-- Camera mount per body: a mast standing on top of the lidar housing (above the lidar's scan plane,
       so the lidar never sees its own mast), camera at the top. Heights above the ground, pitch down +.
         cleaner: 0.45 m, 0.35 rad down: the floor 0.5 m to the far wall, spills and clutter near the middle
         rover:   0.30 m, 0.15 rad up:   a machine panel 0.4-1.1 m high at ~1.3 m, and its lower vent
         field:   0.50 m, 0.12 rad down: the trail, a fallen trunk and a fire ring 2-5 m ahead -->
  <xacro:property name="cam_h" value="${0.45 if variant == 'cleaner' else (0.50 if variant == 'field' else 0.30)}"/>
  <xacro:property name="cam_pitch" value="${0.35 if variant == 'cleaner' else (0.12 if variant == 'field' else -0.15)}"/>
  <xacro:property name="cam_x" value="0.05"/>
  <xacro:property name="mast_bottom" value="${base_z_offset + base_z/2 + 0.03 + 0.025}"/>
  <xacro:property name="mast_top" value="${cam_h - wheel_radius - 0.02}"/>
  <link name="camera_mast">
    <visual>
      <origin xyz="0 0 ${(mast_top - mast_bottom)/2}"/>
      <geometry><cylinder radius="0.012" length="${mast_top - mast_bottom}"/></geometry>
      <material name="graphite"/>
    </visual>
    <inertial><mass value="0.05"/><xacro:cylinder_inertia m="0.05" r="0.012" h="${mast_top - mast_bottom}"/></inertial>
  </link>
  <joint name="camera_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mast"/>
    <origin xyz="${cam_x} 0 ${mast_bottom}"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.08 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <inertial><mass value="0.05"/><xacro:box_inertia m="0.05" x="0.03" y="0.08" z="0.03"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_h - wheel_radius}" rpy="0 ${cam_pitch} 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <topic>/camera/image_raw</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>30.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <link name="imu_link">
    <inertial><mass value="0.01"/><xacro:box_inertia m="0.01" x="0.02" y="0.02" z="0.01"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_z_offset}"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu/data</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- Differential drive (gz-sim 8 DiffDrive system). Publishes odom and odom->base_footprint TF. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_velocity>${max_linear_velocity}</max_linear_velocity>
      <min_linear_velocity>${-max_linear_velocity}</min_linear_velocity>
      <max_angular_velocity>${max_angular_velocity}</max_angular_velocity>
      <min_angular_velocity>${-max_angular_velocity}</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <topic>/model/${model_name}/cmd_vel</topic>
      <odom_topic>/model/${model_name}/odometry</odom_topic>
      <tf_topic>/model/${model_name}/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/${model_name}/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
