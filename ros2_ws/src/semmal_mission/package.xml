<?xml version="1.0"?>
<package format="3">
  <name>semmal_mission</name>
  <version>0.1.0</version>
  <description>ExecuteMission action server: allowlisted named waypoints over a route graph.</description>
  <maintainer email="cvineetjonathan@gmail.com">semmal</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>semmal_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>semmal_navigation</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
